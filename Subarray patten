Subarray patten
Input arr[1,2,3]
Output
[1]               [2]          [3]
[1,2]            [2,3]
[1,2,3]
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        for (int i = 0; i < n ; i++){
            for (int j = i ; j < n ; j++){
                System.out.print("[");
                for (int k = i ; k <= j; k++){
                    System.out.print(arr[k]);
                    if (k < j) {
                        System.out.print(",");
                    }
                }
                System.out.println("]");
            }
            System.out.println();
        }
    }
}
