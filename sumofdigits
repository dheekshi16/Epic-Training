import java.io.*;
import java.util.*;
public class Solution {
    public static void main(String[] args) {
       Scanner sc =  new Scanner(System.in);
       int n = sc.nextInt();
       int result = 0;
       while ( n > 0){
        result += n % 10;
        n /= 10;
       }
       System.out.println(result);
    }
}
