void CreateData(){
    Scanner sc=new Scanner(System.in);
    System.out.println("enter the no of node");
    int n=sc.nextInt();
    for(int i=0;i<n;i++){
        int val=sc.nextInt();
        Node obj=new Node(val, null);
        if(head==null){
            head=obj;
            prev=obj;
        }
        else{
            prev.Address=obj;
            prev=obj;
        }
    }
}
