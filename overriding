class MyData{
    void display(int a){
        System.out.println("One");
    }
}

class MyData2 extends MyData{
    void display(int a){
        System.out.println("Two");
    }
}

public class Main
{
	public static void main(String[] args) {
		MyData obj = new MyData2();//obj binding(Dynamic)
		obj.display(10);
	}
}
